# 复制为 .env 后填写。什么都不填也能跑：大模型退回规则基线，地图用离线数据，语音降级为文字。

# ── 大模型（OpenAI 兼容、支持 tool calling 的接口都可以）──
# 不填 LLM_API_KEY 时，会复用 MINIMAX_API_KEY 调 MiniMax 的大模型
LLM_API_KEY=
LLM_BASE_URL=https://api.minimaxi.com/v1
LLM_MODEL=MiniMax-M2
# 其他可选：
#   DeepSeek：LLM_BASE_URL=https://api.deepseek.com/v1          LLM_MODEL=deepseek-chat
#   通义千问：LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen-plus
# 强制使用规则基线：LLM_PROVIDER=rule
# 成本估算单价（元 / 百万 token），按所用模型官网价格修改
LLM_PRICE_INPUT=2.1
LLM_PRICE_OUTPUT=8.4

# ── 高德（Web 服务 Key，同时用于高德 MCP 和 REST 降级）──
AMAP_KEY=
# 不填则用 https://mcp.amap.com/mcp?key=AMAP_KEY
# AMAP_MCP_URL=

# ── MiniMax 语音 ──
MINIMAX_API_KEY=
MINIMAX_API_HOST=https://api.minimaxi.com
# 旧版 api.minimax.chat 接口需要 GroupId，新版可不填
MINIMAX_GROUP_ID=
MINIMAX_VOICE_ID=female-chengshu
TTS_NARRATION_MODEL=speech-2.8-hd
TTS_CHAT_MODEL=speech-2.8-turbo
# 元 / 万字符
TTS_PRICE_HD=3.5
TTS_PRICE_TURBO=2
# 如果自己起了 HTTP 版 MiniMax MCP，可以填地址；否则按 mcp.json 用 uvx 启动 minimax-mcp（需要先装 uv）
# MINIMAX_MCP_URL=

PORT=3001
